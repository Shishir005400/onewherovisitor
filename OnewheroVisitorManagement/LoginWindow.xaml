<Window x:Class="OnewheroVisitorManagement.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login - Onewhero Heritage Park" 
        Height="650" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="LoginButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3498DB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2980B9"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#1F6391"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RegisterButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#27AE60"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#229954"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#1E8449"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="45"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="InputPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="45"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="White"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Login Section -->
        <Border Grid.Column="0" Background="White" 
                Margin="40,40,20,40" 
                Padding="40"
                CornerRadius="10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25" ShadowDepth="0" Opacity="0.3" Color="#2C3E50"/>
            </Border.Effect>

            <StackPanel>
                <!-- Logo/Header -->
                <Border BorderBrush="#3498DB" 
                        BorderThickness="3" 
                        CornerRadius="5"
                        Padding="15"
                        Margin="0,0,0,15">
                    <TextBlock Text="🏛️" 
                               FontSize="48" 
                               TextAlignment="Center"/>
                </Border>

                <TextBlock Text="Onewhero Bay" 
                           FontSize="24" 
                           FontWeight="Bold"
                           TextAlignment="Center"
                           Foreground="#2C3E50"/>

                <TextBlock Text="Heritage Park" 
                           FontSize="14"
                           TextAlignment="Center"
                           Foreground="#7F8C8D"
                           Margin="0,5,0,10"/>

                <TextBlock Text="LOGIN" 
                           FontSize="20"
                           FontWeight="Bold"
                           TextAlignment="Center"
                           Foreground="#2C3E50"
                           Margin="0,0,0,25"/>

                <!-- Login Form -->
                <TextBlock Text="Username" 
                           FontSize="14" 
                           FontWeight="SemiBold"
                           Foreground="#2C3E50"
                           Margin="0,0,0,8"/>

                <TextBox x:Name="txtUsername" 
                         Style="{StaticResource InputTextBoxStyle}"
                         Margin="0,0,0,20"/>

                <TextBlock Text="Password" 
                           FontSize="14" 
                           FontWeight="SemiBold"
                           Foreground="#2C3E50"
                           Margin="0,0,0,8"/>

                <PasswordBox x:Name="txtPassword" 
                             Style="{StaticResource InputPasswordBoxStyle}"
                             Margin="0,0,0,25"
                             KeyDown="txtPassword_KeyDown"/>

                <!-- Login Button -->
                <Button x:Name="btnLogin" 
                        Content="LOGIN" 
                        Click="btnLogin_Click"
                        Style="{StaticResource LoginButtonStyle}"/>

                <!-- Status Message -->
                <TextBlock x:Name="txtLoginStatus" 
                           Text="" 
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#E74C3C"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,15,0,0"
                           MinHeight="20"/>
            </StackPanel>
        </Border>

        <!-- Register Section -->
        <Border Grid.Column="1" Background="White" 
                Margin="20,40,40,40" 
                Padding="40"
                CornerRadius="10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25" ShadowDepth="0" Opacity="0.3" Color="#27AE60"/>
            </Border.Effect>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="CREATE ACCOUNT" 
                               FontSize="20"
                               FontWeight="Bold"
                               TextAlignment="Center"
                               Foreground="#27AE60"
                               Margin="0,0,0,25"/>

                    <!-- Register Form -->
                    <TextBlock Text="Full Name" 
                               FontSize="13" 
                               FontWeight="SemiBold"
                               Foreground="#2C3E50"
                               Margin="0,0,0,5"/>

                    <TextBox x:Name="txtRegFullName" 
                             Style="{StaticResource InputTextBoxStyle}"
                             Margin="0,0,0,15"/>

                    <TextBlock Text="Username" 
                               FontSize="13" 
                               FontWeight="SemiBold"
                               Foreground="#2C3E50"
                               Margin="0,0,0,5"/>

                    <TextBox x:Name="txtRegUsername" 
                             Style="{StaticResource InputTextBoxStyle}"
                             Margin="0,0,0,15"/>

                    <TextBlock Text="Email" 
                               FontSize="13" 
                               FontWeight="SemiBold"
                               Foreground="#2C3E50"
                               Margin="0,0,0,5"/>

                    <TextBox x:Name="txtRegEmail" 
                             Style="{StaticResource InputTextBoxStyle}"
                             Margin="0,0,0,15"/>

                    <TextBlock Text="Password" 
                               FontSize="13" 
                               FontWeight="SemiBold"
                               Foreground="#2C3E50"
                               Margin="0,0,0,5"/>

                    <PasswordBox x:Name="txtRegPassword" 
                                 Style="{StaticResource InputPasswordBoxStyle}"
                                 Margin="0,0,0,15"/>

                    <TextBlock Text="Confirm Password" 
                               FontSize="13" 
                               FontWeight="SemiBold"
                               Foreground="#2C3E50"
                               Margin="0,0,0,5"/>

                    <PasswordBox x:Name="txtRegConfirmPassword" 
                                 Style="{StaticResource InputPasswordBoxStyle}"
                                 Margin="0,0,0,20"/>

                    <!-- Register Button -->
                    <Button x:Name="btnRegister" 
                            Content="CREATE ACCOUNT" 
                            Click="btnRegister_Click"
                            Style="{StaticResource RegisterButtonStyle}"/>

                    <!-- Status Message -->
                    <TextBlock x:Name="txtRegisterStatus" 
                               Text="" 
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#E74C3C"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,15,0,0"
                               MinHeight="20"/>

                    <!-- Info -->
                    <Border Background="#E8F8F5" 
                            Padding="15"
                            CornerRadius="5"
                            Margin="0,15,0,0">
                        <StackPanel>
                            <TextBlock Text="ℹ️ Account Types" 
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#27AE60"
                                       Margin="0,0,0,5"/>
                            <TextBlock Text="• Regular users can view and book events" 
                                       FontSize="10"
                                       Foreground="#34495E"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="• Only Admin can edit/delete events" 
                                       FontSize="10"
                                       Foreground="#34495E"
                                       TextWrapping="Wrap"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>